# Copy this file to .env and fill in your own key. NEVER commit .env or real keys.

# LLM_PROVIDER: "anthropic" or "openai" ("openai" works with any OpenAI-compatible API)
LLM_PROVIDER=openai

# Key for the chosen provider (leave the other one empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model name. Examples:
#   Groq:       openai/gpt-oss-120b
#   OpenAI:     gpt-4o-mini
#   Anthropic:  claude-sonnet-5-5
LLM_MODEL=openai/gpt-oss-120b

# Only for OpenAI-compatible providers other than OpenAI itself. Examples:
#   Groq:    https://api.groq.com/openai/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_BASE_URL=

# Maximum tool calls the agent may make per audit
MAX_STEPS=30
